#!/bin/bash
# =====================================================
# Script: ตรวจสอบและแก้ไข DISABLE_WP_CRON ทุกเว็บ
# v2.3 — Scan → Summary → Confirm → Fix
#
# GitHub: AnonymousVS/cronjob-disable
#
# Usage:
#   bash edit-disable-wordpress              ← ทุก user
#   bash edit-disable-wordpress user1        ← user เดียว
#   bash edit-disable-wordpress u1 u2 u3     ← หลาย user
#
# โครงสร้าง path ที่รองรับ:
#   /home/USERNAME/public_html/DOMAIN/wp-config.php
#   /home/USERNAME/DOMAIN/wp-config.php
# =====================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
NC='\033[0m'

echo ""
echo "======================================================"
echo "   DISABLE_WP_CRON - Auto Scanner & Fixer v2.3"
echo "======================================================"
echo ""

# ==================== prerequisite ====================

if [[ ! -f /etc/userdomains ]]; then
    echo -e "${RED}❌ ไม่พบ /etc/userdomains — ไม่ใช่ cPanel server?${NC}"
    exit 1
fi

if [[ ! -f /etc/trueuserdomains ]]; then
    echo -e "${RED}❌ ไม่พบ /etc/trueuserdomains${NC}"
    exit 1
fi

# ==================== Filter users จาก argument ====================

FILTER_USERS=()
if [[ $# -gt 0 ]]; then
    FILTER_USERS=("$@")
    echo -e "${YELLOW}🎯 Filter เฉพาะ user:${NC}"
    for u in "${FILTER_USERS[@]}"; do
        if [[ -d "/home/$u" ]]; then
            echo -e "   ✅ ${CYAN}$u${NC}"
        else
            echo -e "   ❌ ${RED}$u${NC} (ไม่พบ /home/$u)"
        fi
    done
    echo ""
else
    echo -e "${BLUE}🌐 สแกนทุก user${NC}"
    echo ""
fi

# helper: เช็คว่า user อยู่ใน filter ไหม
is_target_user() {
    local u="$1"
    [[ ${#FILTER_USERS[@]} -eq 0 ]] && return 0
    for fu in "${FILTER_USERS[@]}"; do
        [[ "$fu" == "$u" ]] && return 0
    done
    return 1
}

# ==================== Build lookup tables ====================
# trueuserdomains format: "domain.com: username"

declare -A MAIN_DOMAIN_SET
declare -A USER_MAIN_DOMAIN

while IFS= read -r line; do
    domain=$(echo "$line" | cut -d: -f1 | tr -d ' ')
    user=$(echo "$line"   | cut -d: -f2 | tr -d ' ')
    [[ -z "$domain" || -z "$user" ]] && continue
    MAIN_DOMAIN_SET["$domain"]=1
    USER_MAIN_DOMAIN["$user"]="$domain"
done < /etc/trueuserdomains

# ==================== PHASE 1: SCAN ====================

NOT_DISABLED=()   # domain|user|config|status|path_type
DISABLED=()       # domain|user|config|path_type
NO_WP=()          # domain|user

echo -e "${BLUE}🔍 กำลังสแกน...${NC}"

while IFS= read -r line; do
    domain=$(echo "$line" | cut -d: -f1 | tr -d ' ')
    user=$(echo "$line"   | cut -d: -f2 | tr -d ' ')

    # กรองออก: ว่าง, nobody, .cp, wildcard
    [[ -z "$domain" || -z "$user" ]]     && continue
    [[ "$user" == "nobody" ]]             && continue
    [[ "$domain" == *.cp ]]              && continue
    [[ "$domain" == \** ]]               && continue

    # กรองออก: main domain
    [[ "${MAIN_DOMAIN_SET[$domain]+_}" ]] && continue

    # กรองออก: cPanel internal subdomain (*.mainDomain)
    user_main="${USER_MAIN_DOMAIN[$user]}"
    [[ -n "$user_main" && "$domain" == *".$user_main" ]] && continue

    # Fast skip: ข้าม user ที่ไม่อยู่ใน filter
    is_target_user "$user" || continue

    # เช็ค 2 path structure
    WP_CONFIG=""
    WP_PATH_TYPE=""
    for check in \
        "/home/${user}/public_html/${domain}/wp-config.php|public_html" \
        "/home/${user}/${domain}/wp-config.php|direct"; do
        wp_path="${check%%|*}"
        path_type="${check##*|}"
        if [[ -f "$wp_path" ]]; then
            WP_CONFIG="$wp_path"
            WP_PATH_TYPE="$path_type"
            break
        fi
    done

    # ไม่พบ wp-config.php → ข้าม
    if [[ -z "$WP_CONFIG" ]]; then
        NO_WP+=("$domain|$user")
        continue
    fi

    # Fast skip: grep -q หยุดทันทีที่เจอ (เร็วกว่าอ่านทั้งไฟล์)
    if grep -q "define.*DISABLE_WP_CRON.*true" "$WP_CONFIG" 2>/dev/null; then
        # ✅ ปิดแล้ว → skip ทันที
        DISABLED+=("$domain|$user|$WP_CONFIG|$WP_PATH_TYPE")
    elif grep -q "DISABLE_WP_CRON" "$WP_CONFIG" 2>/dev/null; then
        # มีแต่เป็น false
        NOT_DISABLED+=("$domain|$user|$WP_CONFIG|set_but_false|$WP_PATH_TYPE")
    else
        # ไม่มีเลย
        NOT_DISABLED+=("$domain|$user|$WP_CONFIG|not_set|$WP_PATH_TYPE")
    fi

done < /etc/userdomains

TOTAL=$(( ${#NOT_DISABLED[@]} + ${#DISABLED[@]} ))

# ==================== PHASE 2: SUMMARY ====================

echo ""
echo "======================================================"
echo -e "  📊 สรุปผลการสแกน"
if [[ ${#FILTER_USERS[@]} -gt 0 ]]; then
    echo -e "  🎯 Filter: ${CYAN}${FILTER_USERS[*]}${NC}"
fi
echo "======================================================"
echo ""

# แสดงรายการที่ยังไม่ปิด
if [[ ${#NOT_DISABLED[@]} -gt 0 ]]; then
    echo -e "${RED}❌ ยังไม่ได้ปิด (${#NOT_DISABLED[@]} โดเมน):${NC}"
    echo "------------------------------------------------------"
    i=1
    for entry in "${NOT_DISABLED[@]}"; do
        domain=$(echo "$entry" | cut -d'|' -f1)
        user=$(echo   "$entry" | cut -d'|' -f2)
        status=$(echo "$entry" | cut -d'|' -f4)
        ptype=$(echo  "$entry" | cut -d'|' -f5)
        [[ "$status" == "set_but_false" ]] \
            && label="${YELLOW}[มีแต่เป็น false]${NC}" \
            || label="${RED}[ไม่มีเลย]${NC}"
        echo -e "  $i. ${CYAN}$domain${NC} (${PURPLE}$user${NC}) [$ptype] $label"
        ((i++))
    done
    echo ""
fi

# แสดงจำนวนที่ปิดแล้ว (ไม่แสดงรายชื่อ เพราะอาจเยอะมาก)
echo -e "${GREEN}✅ ปิดแล้ว (${#DISABLED[@]} โดเมน) — skip${NC}"

# แสดงโดเมนที่ไม่มี WordPress
if [[ ${#NO_WP[@]} -gt 0 ]]; then
    echo ""
    echo -e "${YELLOW}⚠️  ไม่พบ wp-config.php (${#NO_WP[@]} โดเมน — skip):${NC}"
    for entry in "${NO_WP[@]}"; do
        echo -e "   - $(echo "$entry" | cut -d'|' -f1)"
    done
fi

echo ""
echo "======================================================"
echo -e "  🔴 ต้องแก้ไข  : ${RED}${#NOT_DISABLED[@]} โดเมน${NC}"
echo -e "  🟢 skip แล้ว  : ${GREEN}${#DISABLED[@]} โดเมน${NC}"
echo -e "  ⚪ ไม่มี WP   : ${YELLOW}${#NO_WP[@]} โดเมน${NC}"
echo -e "  📁 ทั้งหมด    : ${CYAN}${TOTAL} โดเมน${NC}"
echo "======================================================"
echo ""

# ทุกเว็บปิดแล้ว → จบ
if [[ ${#NOT_DISABLED[@]} -eq 0 ]]; then
    echo -e "${GREEN}🎉 ทุกโดเมนปิด DISABLE_WP_CRON แล้ว ไม่มีอะไรต้องแก้ไข!${NC}"
    echo ""
    exit 0
fi

# ==================== PHASE 3: CONFIRM ====================

echo -e "${YELLOW}ต้องการเพิ่ม define('DISABLE_WP_CRON', true)${NC}"
echo -e "${YELLOW}ให้ ${RED}${#NOT_DISABLED[@]} โดเมน${YELLOW} ที่ยังไม่ได้ปิดหรือไม่?${NC}"
echo ""
echo -e "  ${GREEN}y${NC} = ดำเนินการแก้ไข"
echo -e "  ${RED}n${NC} = ยกเลิก"
echo ""
read -r -p "ยืนยัน (y/n): " CONFIRM

if [[ "$CONFIRM" != "y" && "$CONFIRM" != "Y" ]]; then
    echo ""
    echo -e "${YELLOW}⚠️  ยกเลิก — ไม่มีการแก้ไขใดๆ${NC}"
    echo ""
    exit 0
fi

echo ""

# ==================== PHASE 4: FIX ====================

echo -e "${BLUE}🔧 กำลังแก้ไข...${NC}"
echo ""

SUCCESS=()
FAILED=()

for entry in "${NOT_DISABLED[@]}"; do
    domain=$(echo "$entry" | cut -d'|' -f1)
    user=$(echo   "$entry" | cut -d'|' -f2)
    config=$(echo "$entry" | cut -d'|' -f3)
    status=$(echo "$entry" | cut -d'|' -f4)
    ptype=$(echo  "$entry" | cut -d'|' -f5)

    echo -ne "  🔧 ${CYAN}$domain${NC} (${PURPLE}$user${NC}) [$ptype] ... "

    # Backup ก่อนแก้ไข
    cp "$config" "${config}.bak_$(date +%Y%m%d%H%M%S)" 2>/dev/null

    if [[ "$status" == "set_but_false" ]]; then
        # เปลี่ยน false → true (รองรับ single/double quote + spaces)
        sed -i "s/define\s*(\s*['\"]DISABLE_WP_CRON['\"]\s*,\s*false\s*)/define('DISABLE_WP_CRON', true)/g" \
            "$config" 2>/dev/null
    else
        # ใส่ใหม่ — เลือก marker ตามที่มีในไฟล์
        if grep -q "That's all, stop editing" "$config" 2>/dev/null; then
            sed -i "/That's all, stop editing/i define('DISABLE_WP_CRON', true);" "$config"
        elif grep -q "stop editing" "$config" 2>/dev/null; then
            sed -i "/stop editing/i define('DISABLE_WP_CRON', true);" "$config"
        elif grep -q "require.*wp-settings" "$config" 2>/dev/null; then
            sed -i "/require.*wp-settings/i define('DISABLE_WP_CRON', true);" "$config"
        else
            # fallback: ต่อท้ายไฟล์
            echo "define('DISABLE_WP_CRON', true);" >> "$config"
        fi
    fi

    # ยืนยันผล
    if grep -q "define.*DISABLE_WP_CRON.*true" "$config" 2>/dev/null; then
        echo -e "${GREEN}✅${NC}"
        SUCCESS+=("$domain")
    else
        echo -e "${RED}❌ ล้มเหลว${NC}"
        FAILED+=("$domain|$config")
        # Rollback
        backup=$(ls -t "${config}.bak_"* 2>/dev/null | head -1)
        [[ -f "$backup" ]] && cp "$backup" "$config"
    fi
done

# ==================== PHASE 5: FINAL SUMMARY ====================

echo ""
echo "======================================================"
echo -e "  📊 สรุปผลการแก้ไข"
echo "======================================================"
echo -e "  ✅ สำเร็จ   : ${GREEN}${#SUCCESS[@]} โดเมน${NC}"
echo -e "  ❌ ล้มเหลว  : ${RED}${#FAILED[@]} โดเมน${NC}"
echo -e "  🟢 skip     : ${GREEN}${#DISABLED[@]} โดเมน${NC}"
echo -e "  📁 ทั้งหมด  : ${CYAN}${TOTAL} โดเมน${NC}"
echo "======================================================"

if [[ ${#FAILED[@]} -gt 0 ]]; then
    echo ""
    echo -e "${RED}⚠️  แก้ไขล้มเหลว (ตรวจสอบ permission):${NC}"
    for entry in "${FAILED[@]}"; do
        echo -e "  - ${RED}$(echo "$entry" | cut -d'|' -f1)${NC}"
        echo -e "    → $(echo "$entry" | cut -d'|' -f2)"
    done
fi

echo ""
echo -e "${YELLOW}💡 Backup ไว้ที่: wp-config.php.bak_YYYYMMDDHHMMSS${NC}"
echo ""
